# Template for .env.local, which is untracked. Copy this to that name and fill
# in the values.
#
# Named with an underscore, not .env.example: the studio's Claude Code settings
# deny Edit(**/.env.*), so a dotted name could not be maintained here.
#
# Next.js inlines any NEXT_PUBLIC_ variable into the client bundle at build
# time. Everything else stays on the server. The split below is not cosmetic:
# moving a key across it changes who can read it.

# --- Server only. Never prefix these with NEXT_PUBLIC_. ---

# reCAPTCHA v3 secret. Verifies tokens against Google from the server. This is
# a real secret: with it, anyone can validate their own tokens as this site.
RECAPTCHA_V3_SECRET_KEY=

# --- Sent to the browser. Public by design. ---

# reCAPTCHA v3 site key. Rendered into the page, so it is public whether or not
# it carries the prefix.
RECAPTCHA_V3_SITE_KEY=

# Google Tag Manager. Both names exist because the server code and the client
# component read different ones; keep them equal.
GTM_ID=
NEXT_PUBLIC_GTM_ID=

# Google Analytics measurement id.
GA_TRACKING_ID=

# AdSense publisher id.
ADSENSE_ID=

# Canonical origin, used to build absolute URLs in metadata and sitemaps.
BASE_URL=

# Google Form id for the contact page.
GOOGLE_FORM_ID=

# Link target for the family movie section.
FAMILY_MOVIE_URL=
